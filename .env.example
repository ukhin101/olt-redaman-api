# ============================================================================
# KONFIGURASI OLT REDAMAN API (HSGQ & HIOSO)
# ============================================================================
# Salin file ini menjadi ".env" dan sesuaikan dengan alamat IP serta kredensial
# perangkat OLT Anda. File ".env" diabaikan oleh Git (.gitignore) demi keamanan.
# ============================================================================

# --- PENGATURAN UMUM APLIKASI ---
APP_NAME="OLT Redaman API"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# Kunci API opsional (Kosongkan jika API dapat diakses langsung di jaringan lokal)
# Jika diisi, kirim melalui header "X-API-Key: <kunci>" atau query "?api_key=<kunci>"
API_KEY=

# Pengaturan Cache (dalam detik) untuk mencegah overload request ke OLT
# Set CACHE_ENABLED=false atau gunakan parameter ?refresh=1 untuk selalu ambil real-time
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30

# Batas ambang redaman optik ( dalam dBm ) untuk kategorisasi kualitas sinyal
SIGNAL_EXCELLENT_THRESHOLD=-18.0
SIGNAL_GOOD_THRESHOLD=-23.0
SIGNAL_FAIR_THRESHOLD=-26.0
SIGNAL_CRITICAL_THRESHOLD=-27.0


# ============================================================================
# 1. KONFIGURASI OLT HSGQ (EPON / GPON)
# ============================================================================
HSGQ_ENABLED=true
HSGQ_NAME="OLT-HSGQ-01"
HSGQ_HOST=192.168.150.2
HSGQ_PORT=80
HSGQ_SCHEME=http
HSGQ_USERNAME=admin
HSGQ_PASSWORD=your_hsgq_password_here

# Metode koneksi HSGQ:
# - http   : (Direkomendasikan) Web JSON API bawaan HSGQ (/userlogin, /onu_list, /onu_optical_info)
# - telnet : Pembacaan CLI Read-Only via Telnet
# - auto   : Coba HTTP API terlebih dahulu, fallback ke Telnet jika diperlukan
HSGQ_METHOD=http

# Tipe OLT HSGQ (EPON atau GPON) dan jumlah port PON (4, 8, atau 16)
HSGQ_TYPE=EPON
HSGQ_PON_PORTS=8
HSGQ_TIMEOUT=15
HSGQ_TELNET_PORT=23


# ============================================================================
# 2. KONFIGURASI OLT HIOSO (EPON / GPON - HA7302CS / HA7304 / HA7308)
# ============================================================================
HIOSO_ENABLED=true
HIOSO_NAME="OLT-HIOSO-01"
HIOSO_HOST=192.168.0.88

# Metode koneksi HIOSO:
# - snmp   : (Direkomendasikan) SNMP v2c Read-Only (cepat & aman tanpa sesi login web)
# - http   : Pembacaan halaman Web Management ASP Hioso (/onuConfigPonList.asp, /onuOpticalList.asp)
# - telnet : Pembacaan CLI Read-Only via Telnet (show onu info / show onu optical-ddm)
# - auto   : Coba SNMP terlebih dahulu, otomatis fallback ke HTTP / Telnet jika SNMP tidak aktif
HIOSO_METHOD=auto

# Pengaturan SNMP OLT HIOSO (Digunakan saat HIOSO_METHOD=snmp atau auto)
HIOSO_SNMP_PORT=161
HIOSO_SNMP_COMMUNITY=public
HIOSO_SNMP_TIMEOUT_SEC=3
HIOSO_SNMP_RETRIES=2
# Pilihan profil MIB: auto, HIOSO_C (C-Data EPON), HIOSO_GPON, HIOSO_B (BDCOM), HIOSO_STD (17409)
HIOSO_SNMP_PROFILE=auto

# Pengaturan Web / Telnet OLT HIOSO (Digunakan saat HIOSO_METHOD=http, telnet, atau fallback auto)
HIOSO_HTTP_PORT=80
HIOSO_TELNET_PORT=23
HIOSO_USERNAME=admin
HIOSO_PASSWORD=your_hioso_password_here
HIOSO_TYPE=EPON
HIOSO_PON_PORTS=4
HIOSO_TIMEOUT=15

# Override OID Kustom HIOSO (Opsional - kosongkan untuk menggunakan deteksi profil otomatis)
HIOSO_OID_NAME=
HIOSO_OID_SN=
HIOSO_OID_STATUS=
HIOSO_OID_RX=
HIOSO_OID_TX=
